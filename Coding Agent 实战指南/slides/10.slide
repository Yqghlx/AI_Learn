      ].map((item, idx) => (
        <Box key={idx} style={{ flex: 1, flexDirection: 'row', gap: 14, borderLeft: idx === 0 ? 'none' : '1px solid rgba(232,237,245,0.1)', paddingLeft: idx === 0 ? 0 : 24, paddingRight: 24 }}>
          <Text style={{ fontSize: 34, fontWeight: 'bold', fontFamily: 'JetBrains Mono, monospace', color: '#35D0BA', lineHeight: 1 }}>{item.no}</Text>
          <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#E8EDF5' }}>{item.title}</Text>
            <Text style={{ fontSize: 14.5, color: 'rgba(232,237,245,0.65)', lineHeight: 1.55 }}>{item.desc}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>

  <Box style={{ position: 'absolute', left: 64, bottom: 0, width: 1152, height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
